{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crownpath.local/schemas/findings.schema.json",
  "title": "CrownPath findings ingest contract",
  "$comment": "Frozen by issue #5 (A5). Single document carrying every node and edge lib/ingest.py (B2) needs to build the graph in BUILD_SPEC.md §6, except Technique nodes and CHAINS_TO edges which come from the seeded taxonomy (issue #14 / B3). FROZEN INGEST RULES: (1) only findings with status=='confirmed' produce the attack edges GRANTS and LEADS_TO -- non-confirmed findings still create the Finding node plus HAS_FINDING and INSTANCE_OF edges (visible for audit) but carry NO attack edges (BUILD_SPEC.md Section 5 proof-discipline, Section 6). (2) technique_id must match a Technique id already seeded by issue #14; a loader that encounters a technique_id with no matching Technique must hard-fail the load, never silently skip.",
  "type": "object",
  "required": ["assets", "endpoints", "identities", "findings"],
  "additionalProperties": false,
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type", "is_crown_jewel", "value"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "type": {"type": "string", "enum": ["host", "service", "webapp", "database"]},
          "environment": {"type": "string"},
          "is_crown_jewel": {"type": "boolean"},
          "value": {"type": "integer"}
        }
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "asset_id", "url", "method", "auth_required"],
        "properties": {
          "id": {"type": "string"},
          "asset_id": {"type": "string", "description": "FK -> assets.id; builds Asset-EXPOSES-Endpoint"},
          "url": {"type": "string"},
          "method": {"type": "string"},
          "auth_required": {"type": "boolean"}
        }
      }
    },
    "identities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "privilege_level"],
        "properties": {
          "id": {"type": "string"},
          "role": {"type": "string", "enum": ["anonymous", "user", "admin"]},
          "privilege_level": {"type": "integer", "enum": [0, 1, 3], "description": "must match role: anonymous=0, user=1, admin=3"}
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "FROZEN RULE: only status=='confirmed' findings produce the attack edges GRANTS and LEADS_TO. inconclusive/refuted findings still create the Finding node and its HAS_FINDING + INSTANCE_OF edges but carry no attack edges. technique_id must match a Technique id seeded by issue #14 (B3); an unmatched technique_id is a hard load error, never a silent skip.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "vuln_type", "confidence", "status", "endpoint_id", "technique_id"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "vuln_type": {
            "type": "string",
            "enum": ["xss", "sqli", "idor", "ssrf", "ssti", "lfi", "open_redirect",
                     "csrf", "cors", "path_traversal", "rce", "info_disclosure",
                     "auth_bypass", "mass_assignment", "deserialization", "file_upload"]
          },
          "cwe": {"type": "string"},
          "cvss": {"type": "number", "minimum": 0, "maximum": 10},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "status": {"type": "string", "enum": ["confirmed", "inconclusive", "refuted"]},
          "discovered_at": {"type": "string", "format": "date-time"},
          "evidence": {"type": "string"},
          "endpoint_id": {"type": "string", "description": "FK -> endpoints.id; builds Endpoint-HAS_FINDING-Finding"},
          "technique_id": {"type": "string", "description": "FK -> Technique.id seeded by B3; builds Finding-INSTANCE_OF-Technique"},
          "grants_identity_id": {"type": "string", "description": "FK -> identities.id; builds Finding-GRANTS-Identity (confirmed only)"},
          "leads_to_asset_id": {"type": "string", "description": "FK -> assets.id; builds Finding-LEADS_TO-Asset (confirmed only)"}
        }
      }
    },
    "connections": {
      "type": "array",
      "description": "Asset-CONNECTS_TO-Asset; optional, default empty",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from_asset_id", "to_asset_id"],
        "properties": {
          "from_asset_id": {"type": "string"},
          "to_asset_id": {"type": "string"}
        }
      }
    },
    "access": {
      "type": "array",
      "description": "Identity-CAN_ACCESS-Asset; optional, default empty",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity_id", "asset_id"],
        "properties": {
          "identity_id": {"type": "string"},
          "asset_id": {"type": "string"}
        }
      }
    }
  }
}
