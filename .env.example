# Copy to .env and fill in. Point these at any FalkorDB (Cloud or local Docker).
# For the local Docker path (docker-compose): host=localhost port=6379 SSL=false, no user/pass.
# For FalkorDB Cloud: use the instance's host/port/user/password and SSL=true.
FALKORDB_HOST=
FALKORDB_PORT=
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_SSL=
CROWNPATH_GRAPH=crownpath

# --- agent LLM path (agent/run.py, issue #18) ---------------------------------
# Three ways to answer a question, tried in this order:
#   1. ANTHROPIC_API_KEY set       -> Anthropic tool-use loop
#   2. LLM_API_KEY + LLM_BASE_URL  -> any OpenAI-compatible provider (below)
#   3. neither set, or --no-llm    -> deterministic offline path (no network)
# The deterministic path is the committed P0 demo path and always works without
# any of the following. Fill in ONE of the two provider blocks below if you want
# to run the real LLM tool-use loop against a free provider.
ANTHROPIC_API_KEY=

# Generic OpenAI-compatible settings used by option 2 above.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Option: Google Gemini (preferred -- generous free tier) ------------------
# Get a free key at https://aistudio.google.com/apikey, then uncomment and fill:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=<your Gemini API key>
# NOTE (unverified live -- see issue #18): confirm gemini-2.5-flash is still the
# current free-tier model with reliable tool/function calling on this endpoint
# before relying on it; Google's model lineup moves fast. Check
# https://ai.google.dev/gemini-api/docs/openai for the current model list.

# --- Option: Groq (fast, free tier, open models) -------------------------------
# Get a free key at https://console.groq.com/keys, then uncomment and fill:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=<your Groq API key>
# NOTE (unverified live -- see issue #18): openai/gpt-oss-120b is Groq's current
# recommended tool-calling model as of this writing; llama-3.3-70b-versatile was
# a long-standing alternative but reports say Groq began deprecating it on the
# free/developer tier in mid-2026. Check https://console.groq.com/docs/models
# for the current list before relying on either.
